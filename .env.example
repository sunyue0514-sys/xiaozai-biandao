# Copy to .env.local. Never commit actual values.
# Private backend credentials for the new database initialization scheme.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy server key alternative (configure only one key).
SUPABASE_SERVICE_ROLE_KEY=
# Existing Coze deployment aliases remain supported for compatibility.
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
PGDATABASE_URL=

# Private Coze AI gateway configuration. SDK 0.7.17 has no default endpoints.
# Required for LLM: identity API key + model gateway URL.
COZE_WORKLOAD_IDENTITY_API_KEY=
COZE_INTEGRATION_MODEL_BASE_URL=
# Required for SDK search/ASR/video tools when used.
COZE_INTEGRATION_BASE_URL=

# External video services, configured only when used.
TIKHUB_API_KEY=
VIDEO_PARSE_API_TOKEN=
VIDEO_PARSE_API_CKEY=

NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DOMAIN=
COZE_PROJECT_DOMAIN_DEFAULT=

# Explicit CLI bootstrap. Empty password = strong random password shown once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
EMERGENCY_ADMIN_KEY=
CRON_SECRET=
DEBUG_TOKEN=
DEPLOY_RUN_PORT=5000

# Comma-separated datasets explicitly containing public, non-personal material.
# Empty = public knowledge search disabled. Never list another user's dataset.
KNOWLEDGE_PUBLIC_DATASETS=
# Exact browser origins permitted for cookie-authenticated writes.
TRUSTED_APP_ORIGINS=
# Per-process ceilings; production replicas also require a shared gateway quota.
AI_REQUESTS_PER_MINUTE=20
AI_REQUESTS_PER_DAY=100
AI_MAX_JSON_BYTES=262144
# Exact permitted public storage hostnames for model image/video messages.
AI_MEDIA_ALLOWED_HOSTS=
